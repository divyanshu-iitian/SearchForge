{
  "name": "searchforge-rag",
  "version": "0.2.0",
  "description": "Open-source web search API and MCP server for LLMs, AI agents, and RAG.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "searchforge": "./dist/cli.js",
    "searchforge-mcp": "./dist/mcp.js"
  },
  "mcpName": "io.github.divyanshu-iitian/searchforge",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "web-search",
    "rag",
    "llm",
    "ai-agents",
    "mcp",
    "searxng",
    "metasearch",
    "free-api",
    "academic-search",
    "github-search",
    "mcp-server",
    "llm-web-search",
    "rag-web-search",
    "self-hosted-search"
  ],
  "author": "Divyanshu <divyanshu-iitian@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divyanshu-iitian/SearchForge.git"
  },
  "bugs": {
    "url": "https://github.com/divyanshu-iitian/SearchForge/issues"
  },
  "homepage": "https://divyanshu-iitian.github.io/SearchForge/",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
